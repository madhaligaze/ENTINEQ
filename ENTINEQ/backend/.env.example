# === ENTINEQ (публичное приложение) — переменные окружения ===
# Локально: скопируйте этот файл в .env. В Railway те же имена задаются во вкладке Variables.

# ---------- обязательные (обе — про связь с ядром ENTINEQ_AGENT) ----------

# Адрес ядра: только сайт, без пути и без завершающего слеша.
# В Railway это публичный домен проекта ENTINEQ_AGENT, например https://entineq-agent-production.up.railway.app
AGENT_BASE_URL=http://localhost:8080

# Тот же секрет, что в ENTINEQ_AGENT (INTERNAL_API_SECRET). Не короче 32 символов.
# Сгенерировать: pnpm gen:secret  — и вписать одно и то же значение в оба проекта.
# (значение ниже — только для локальной разработки)
INTERNAL_API_SECRET=dev-only-secret-change-me-0123456789abcdef

# ---------- необязательные ----------
# PORT=8081                              # в Railway задаётся автоматически; локально ядро занимает 8080
# AGENT_TIMEOUT_MS=15000                 # сколько ждать ответа ядра на обычный запрос
# RATE_LIMIT_AUTH_PER_MIN=10             # попыток входа/регистрации в минуту с одного IP
# RATE_LIMIT_WS_PER_MIN=30               # открытий чата в минуту с одного IP
# TRUST_PROXY_HOPS=1                     # сколько прокси перед приложением (Railway — один; локально 0)
# COOKIE_SECURE=false                    # локально по http в боевом режиме; в продакшене (https) не задавать
# ALLOWED_ORIGINS=                       # только если страница открывается не с адреса самого приложения
# LOG_LEVEL=info
