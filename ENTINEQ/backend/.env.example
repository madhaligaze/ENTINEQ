# === ENTINEQ / backend (публичное приложение) - переменные окружения ===
# Локально: скопируйте этот файл в .env. В Railway те же имена задаются во вкладке Variables.
# У этого бэкенда нет ни ключа Anthropic, ни базы данных: он пересылает запросы в бэкенд ENTINEQ_AGENT.

# ---------- обязательные ----------

# Адрес бэкенда ENTINEQ_AGENT: только сервис, без пути и без завершающего слеша.
# Локально:  http://localhost:8080
# Railway (внутренняя сеть проекта, бэкенду ENTINEQ_AGENT публичный домен не нужен):
#   AGENT_BASE_URL=http://${{entineq-agent-backend.RAILWAY_PRIVATE_DOMAIN}}:${{entineq-agent-backend.PORT}}
# Railway (по публичному адресу): https://<домен>.up.railway.app
AGENT_BASE_URL=http://localhost:8080

# Тот же секрет, что в бэкенде ENTINEQ_AGENT (INTERNAL_API_SECRET). Не короче 32 символов.
# Сгенерировать: pnpm gen:secret  - и вписать одно и то же значение в оба проекта.
# (значение ниже - только для локальной разработки)
INTERNAL_API_SECRET=dev-only-secret-change-me-0123456789abcdef

# Публичный адрес ФРОНТЕНДА этого проекта (ENTINEQ/frontend), несколько - через запятую.
# Браузер присылает именно его в заголовке Origin; запросы с других адресов отклоняются (защита от CSRF).
# В production обязателен. Локально - адрес dev-сервера фронтенда.
# Railway:  ALLOWED_ORIGINS=https://${{entineq-frontend.RAILWAY_PUBLIC_DOMAIN}}
ALLOWED_ORIGINS=http://localhost:3001

# ---------- сеть ----------
PORT=8081                              # локально ядро занимает 8080; в Railway задайте явно (8080): на него ссылается фронтенд
# HOST=                                # по умолчанию слушает на всех интерфейсах (IPv6 и IPv4)
# TRUST_PROXY_HOPS=1                   # сколько прокси перед бэкендом: фронтенд-сервис - один (если открыт ещё и публично - 2)

# ---------- необязательные ----------
# AGENT_TIMEOUT_MS=15000                 # сколько ждать ответа ядра на обычный запрос
# RATE_LIMIT_AUTH_PER_MIN=60             # запасной предел попыток входа/регистрации с одного IP (основной - на фронтенде)
# RATE_LIMIT_WS_PER_MIN=120              # запасной предел открытий чата с одного IP
# COOKIE_SECURE=false                    # локально по http в боевом режиме; в продакшене (https) не задавать
# LOG_LEVEL=info
