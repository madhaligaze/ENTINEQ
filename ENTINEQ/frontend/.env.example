# === ENTINEQ / frontend - переменные окружения ===
# Локально: скопируйте этот файл в .env. В Railway те же имена задаются во вкладке Variables.

# ---------- обязательная ----------

# Адрес бэкенда ENTINEQ: только сервис, без пути и без завершающего слеша.
# Локально:  http://localhost:8081
# Railway (внутренняя сеть проекта, бэкенду публичный домен не нужен):
#   BACKEND_URL=http://${{entineq-backend.RAILWAY_PRIVATE_DOMAIN}}:${{entineq-backend.PORT}}
# Railway (по публичному адресу): https://<домен-бэкенда>.up.railway.app
BACKEND_URL=http://localhost:8081

# ---------- необязательные ----------
PORT=3001                              # локально; в Railway задаётся автоматически
# BACKEND_TIMEOUT_MS=30000             # сколько ждать ответа бэкенда на обычный запрос
# RATE_LIMIT_AUTH_PER_MIN=10           # попыток входа/регистрации в минуту с одного IP (основной предел)
# RATE_LIMIT_WS_PER_MIN=30             # открытий чата в минуту с одного IP
TRUST_PROXY_HOPS=0                     # локально 0; в Railway по умолчанию 1 (перед сервисом стоит их прокси) - строку не задавайте
# HOST=                                # по умолчанию слушает на всех интерфейсах (IPv6 и IPv4)
# LOG_LEVEL=info
