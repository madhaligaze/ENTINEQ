# === ENTINEQ_AGENT / backend - переменные окружения ===
# Локально: скопируйте этот файл в .env и поправьте. В Railway те же имена задаются во вкладке Variables.

# ---------- обязательные ----------

# Общий секрет между этим бэкендом и бэкендом публичного приложения ENTINEQ. Не короче 32 символов, в обоих ОДИНАКОВЫЙ.
# Сгенерировать: pnpm gen:secret
# (значение ниже - только для локальной разработки; в продакшене замените)
INTERNAL_API_SECRET=dev-only-secret-change-me-0123456789abcdef

# Ключ Anthropic. Хранится только здесь - остальные сервисы его не получают.
ANTHROPIC_API_KEY=sk-ant-...

# Владелец: создаётся при первом запуске (если владельца ещё нет). После первого входа OWNER_PASSWORD можно удалить.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=придумайте-длинный-пароль-от-10-символов

# Публичный адрес ФРОНТЕНДА этого проекта (ENTINEQ_AGENT/frontend), несколько - через запятую.
# Браузер присылает именно его в заголовке Origin; запросы с других адресов отклоняются (защита от CSRF).
# В production обязателен. Локально - адрес dev-сервера фронтенда.
# Railway:  ALLOWED_ORIGINS=https://${{entineq-agent-frontend.RAILWAY_PUBLIC_DOMAIN}}
ALLOWED_ORIGINS=http://localhost:3000

# ---------- база данных ----------

# Локально можно не задавать: тогда используется встроенная БД в папке .data (только для разработки).
# С Docker:  pnpm db:up  и  DATABASE_URL=postgres://entineq:entineq@localhost:5432/entineq
# В Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}   (ссылка на сервис PostgreSQL в том же проекте)
# DATABASE_URL=
# DATABASE_SSL=true   # только если подключаетесь к БД снаружи Railway (по публичному адресу)

# ---------- сеть ----------
PORT=8080                              # в Railway задайте явно (8080): на него ссылаются фронтенд и бэкенд ENTINEQ
# HOST=                                # по умолчанию слушает на всех интерфейсах (IPv6 и IPv4)
# TRUST_PROXY_HOPS=1                   # сколько прокси перед бэкендом: фронтенд-сервис - один (если открыт ещё и публично - 2)

# ---------- модель и агент ----------

# Заглушка вместо Claude - для проверки интерфейса бесплатно: AGENT_RUNNER=fake
# AGENT_RUNNER=claude
# AGENT_MODEL=claude-opus-5-5          # модель для владельца и доверенных
# PUBLIC_AGENT_MODEL=claude-sonnet-5-5 # модель для публичных пользователей (по умолчанию = AGENT_MODEL); вдвое дешевле
# DATA_DIR=./.data                     # рабочие папки агента; в Docker это /data

# ---------- лимиты расходов ----------
# Окно сессии (как 5-часовой лимит у подписок): стартует с первого сообщения и длится SESSION_WINDOW_HOURS часов.
# Достиг лимита окна - блокировка до его конца. Месячный лимит работает отдельно (календарный месяц, UTC).
# Значения ниже - по умолчанию для НОВЫХ пользователей; у каждого можно изменить в админке.
# SESSION_WINDOW_HOURS=5
# PUBLIC_DEFAULT_WINDOW_LIMIT_USD=1
# PUBLIC_DEFAULT_BUDGET_USD=10
# TRUSTED_DEFAULT_WINDOW_LIMIT_USD=5
# TRUSTED_DEFAULT_BUDGET_USD=            # пусто = без месячного лимита
# TURN_MAX_BUDGET_USD=10                 # потолок стоимости одного запроса (страховка от «убежавшего» агента)

# ---------- прочее ----------
# MAX_CONCURRENT_TURNS=4                 # сколько запросов к агенту выполняется одновременно
# TURN_TIMEOUT_MS=600000                 # максимум времени на один запрос
# TRUSTED_MAX_TURNS=50                   # максимум шагов агента за запрос (доверенные)
# PUBLIC_MAX_TURNS=5                     # то же для публичных
# SESSION_TTL_DAYS=30                    # срок жизни входа
# RATE_LIMIT_LOGIN_PER_MIN=60            # запасной предел попыток входа с одного IP (основной - на фронтенде)
# RATE_LIMIT_WS_PER_MIN=120              # запасной предел открытий чата с одного IP
# COOKIE_SECURE=false                    # локально по http в боевом режиме; в продакшене (https) не задавать
# LOG_LEVEL=info
